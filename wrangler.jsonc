{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "public-notebook-network",
  "compatibility_date": "2024-09-23",
  "main": "./.output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "0519136e-346c-4f11-9387-3c3ff15fc76d"
    }
  ]
}
